# Copy to backend/.env for local runs; set the same names as Railway variables.
# Named env.example (no leading dot) so .gitignore's .env rules never eat it.

# --- Runtime posture -------------------------------------------------------
# development | production. Production refuses unsafe combinations at startup.
COACH_ENV=development
# memory | postgres. Production refuses memory unless COACH_ALLOW_MEMORY_STORE=1.
COACH_STORE=memory
# Supabase transaction pooler DSN (port 6543). Never echo it in a shell: DB
# passwords often contain $ or ! which zsh expands. Edit this file with `open -e`.
DATABASE_URL=

# --- Jev (TypeSafe System One) ---------------------------------------------
# openrouter | typesafe
JEV_PROVIDER=openrouter
# replay = recorded responses only (offline, strict); live = real calls behind
# the per-question cache seeded from the recordings.
JEV_MODE=replay
# Canonical pin, matched against the Settings tab. Never an alias.
JEV_PINNED_VERSION=jev-1.13.0
# Request model for the chosen provider. Never latest/preview/~ aliases.
JEV_MODEL=typesafe/jev-1.13-20260917
# Served snapshots the calibrations were measured on (comma-separated). A
# response from any other snapshot is not graded.
JEV_ALLOWED_SNAPSHOTS=typesafe/jev-1.13-20260917
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# OpenRouter routing privacy: deny | allow
JEV_DATA_COLLECTION=deny

# --- Auth --------------------------------------------------------------------
# Comma-separated: google, sheet_key
COACH_AUTH_MODES=google,sheet_key
# The script's OAuth client ID(s), read off "Coach > Admin > Show connection info".
GOOGLE_AUDIENCES=
# Optional Google Workspace domain allowlist (hd claim), comma-separated.
GOOGLE_HOSTED_DOMAINS=
# Reject verified emails that are not in team_roles (default) or admit them
# as preparers.
COACH_ALLOW_UNLISTED=no

# --- Limits ------------------------------------------------------------------
COACH_MAX_BODY_BYTES=1048576
COACH_RATE_LIMIT_PER_MINUTE=60
COACH_LOCK_TTL_SECONDS=180
